# Copy to `.env` and fill in. Never commit `.env`.
# On Vercel, set these same six as Project → Settings → Environment Variables (Production).

# --- Shopify -----------------------------------------------------------------
# Partner Dashboard → your app → API credentials (the key is also `client_id`
# in shopify.app.toml — the two must match).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Must be byte-identical to `scopes` in shopify.app.toml. If these drift apart
# the app gets stuck in an OAuth re-grant loop on install.
SCOPES=read_files,read_products,read_publications,write_metaobject_definitions,write_metaobjects,write_products,write_publications

# The deployed origin, no trailing slash. Must match `application_url` in
# shopify.app.toml. `shopify app dev` overrides this with the tunnel URL.
SHOPIFY_APP_URL=https://custom-ring-creator.vercel.app

# --- Supabase ----------------------------------------------------------------
# Supabase → Project Settings → API. The secret is the `service_role` key: it
# bypasses row-level security, so it is server-only — see app/supabase.server.js.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Optional ----------------------------------------------------------------
# Theme app extension UUID. With it, the Home page's "Activate block" button
# drops the Diamond Selector straight into the product template; without it the
# button just opens the template and the merchant adds the block by hand.
# Find it in the Partner Dashboard under the theme extension, or in the URL of
# the extension's page. No Admin API query exposes it.
# SHOPIFY_THEME_EXTENSION_ID=
# Only if the store is reached on a custom domain rather than *.myshopify.com.
# SHOP_CUSTOM_DOMAIN=
